rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Take-home demo: Manager + POS share one venue without Auth.
    // Tighten these before a production deploy (see commented helpers below).
    match /{document=**} {
      allow read, write: if true;
    }

    // Production-style rules (enable after Firebase Auth is wired):
    // function signedIn() { return request.auth != null; }
    // function userData() {
    //   return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    // }
    // function sameVenue(venueId) {
    //   return signedIn() && userData().venueId == venueId;
    // }
    // function isManager() {
    //   return signedIn() && userData().role == 'manager';
    // }
  }
}